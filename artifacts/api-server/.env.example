[TEMPLATE]
# Copy to .env and fill in. Never commit .env.
DUNKAPI_API_KEY=

# Optional model tuning
# DUNKAPI_CACHE_MINUTES=360
# DUNKAPI_MAX_GAMES=1
# DUNKAPI_MAX_PLAYERS=6
# DUNKAPI_MIN_EDGE=0.025
# DUNKAPI_MAX_PICKS=12

# First-basket tracker
# FIRST_BASKET_CACHE_MINUTES=360
# FIRST_BASKET_MAX_GAMES=2
# FIRST_BASKET_MAX_PLAYERS=10
# FIRST_BASKET_MIN_PROBABILITY=0.004

# Audit ledger (defaults to .data/audit.json beside the server)
# AUDIT_STORE_PATH=

# Discord community
# Simplest option: a public invite link shown in the sidebar and header.
# DISCORD_INVITE_URL=https://discord.gg/your-invite

# Optional one-click auto-join (OAuth). The bot must be in the guild with the
# "Create Instant Invite" permission and the redirect must be registered in the
# Discord developer portal.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=
# DISCORD_BOT_TOKEN=
# PUBLIC_APP_URL=https://your-app.example.com
# DISCORD_REDIRECT_URI=https://your-app.example.com/api/auth/discord/callback
